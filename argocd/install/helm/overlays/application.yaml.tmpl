apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Instance }}
  namespace: {{ .Values.namespace }}
spec:
  project: default
  source:
    repoURL: {{ .Values.repoURL }}
    targetRevision: {{ .Values.targetRevision }}
    path: base/packages/{{ .Instance }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .Values.namespace }}
  syncPolicy:
    automated:
      selfHeal: true
      prune: true
