apiVersion: v1
kind: Secret
metadata:
  name: {{ .Instance }}
  namespace: {{ .Values.namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: {{ .Values.repoURL }}
  username: {{ .Values.repoUsername }}
  password: {{ .Values.repoPassword }}
