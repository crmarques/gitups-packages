apiVersion: declarest.io/v1alpha1
kind: SecretStore
metadata:
  name: {{ .ResourceName }}
  namespace: {{ .Values.namespace }}
spec:
{{- if eq .Values.kind "vault" }}
  vault:
    address: {{ .Values.vault.address }}
    auth:
      token:
        secretRef:
          name: {{ .Values.vault.auth.token.secretRef.name }}
          key: {{ .Values.vault.auth.token.secretRef.key }}
{{- else }}
  file:
    path: {{ .Values.file.path }}
    encryption:
      passphraseRef:
        name: {{ .Values.file.passphrase.secretRef.name }}
        key: {{ .Values.file.passphrase.secretRef.key }}
    storage:
      pvc:
        accessModes:
          - {{ .Values.storage.accessMode }}
        requests:
          storage: {{ .Values.storage.size }}
{{- end }}
