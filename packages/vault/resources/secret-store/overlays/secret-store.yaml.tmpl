apiVersion: declarest.io/v1alpha1
kind: SecretStore
metadata:
  name: {{ .ResourceName }}
  namespace: {{ .Values.namespace }}
spec:
  vault:
    address: {{ .Values.vault.scheme }}://{{ .Values.vault.service }}.{{ .Values.vault.namespace }}.svc:{{ .Values.vault.port }}
    auth:
      token:
        secretRef:
          name: {{ .Values.tokenSecretRef.name }}
          key: {{ .Values.tokenSecretRef.key }}
