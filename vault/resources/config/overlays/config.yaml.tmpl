apiVersion: v1
kind: ConfigMap
metadata:
  name: vault-env-config
  namespace: {{ .Values.namespace }}
  labels:
    app.kubernetes.io/name: vault
    app.kubernetes.io/part-of: support-services
data:
  profile: "{{ .Env }}"
  service-url: "http://vault.{{ .Values.namespace }}.svc.cluster.local:8200"

